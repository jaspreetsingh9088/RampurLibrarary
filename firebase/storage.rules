rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.librarian == true);
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024;
    }

    // Book covers & event banners — public read, staff write
    match /covers/{file=**} {
      allow read: if true;
      allow write: if isStaff() && isImage();
    }
    match /events/{file=**} {
      allow read: if true;
      allow write: if isStaff() && isImage();
    }

    // Profile photos — owner writes, anyone signed in can read
    match /avatars/{uid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImage();
    }
  }
}
